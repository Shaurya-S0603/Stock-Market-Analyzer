# ONLY the Next.js server reads this; do not use a NEXT_PUBLIC_ prefix.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# GitHub OAuth app callback: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# MUST match the FastAPI server secret; never use NEXT_PUBLIC_ prefixes.
QUANTEDGE_API_JWT_SECRET=
