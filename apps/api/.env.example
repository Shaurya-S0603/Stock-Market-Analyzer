# Optional for Stage 0 connectivity probes. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://quantedge:local-dev-only-password@localhost:5432/quantedge
REDIS_URL=redis://localhost:6379/0

# Opt-in local historical research only; NEVER enable a public service without limits.
QUANTEDGE_ENABLE_HISTORICAL_RESEARCH=0

# 32+ random characters, shared ONLY by FastAPI and Next.js servers.
# Keep unconfigured for public deployment until OAuth and migrations are set up.
QUANTEDGE_API_JWT_SECRET=
